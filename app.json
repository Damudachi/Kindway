{
  "expo": {
    "name": "Kindway",
    "slug": "kindway",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kindway",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.kindway"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14181D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "blockedPermissions": ["android.permission.READ_MEDIA_IMAGES"],
      "package": "app.kindway",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EFEA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#14181D",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4D6474"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/literata/400Regular/Literata_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "Kindway",
              "label": "Kindway",
              "description": "Today’s prompt or your next small step, and a way to write. Never your entries.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/widget-preview.png",
              "updatePeriodMillis": 10800000
            }
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.work.InputMerger { public <init>(); }"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kindway to use Face ID to unlock your journal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8cf8b35-8208-44a8-840a-2556e667608f"
      }
    },
    "owner": "damudachi",
    "updates": {
      "url": "https://u.expo.dev/a8cf8b35-8208-44a8-840a-2556e667608f"
    }
  }
}
