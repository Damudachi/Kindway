# Copy to .env (ignored by Git) and fill in from Supabase: Project Settings > API Keys.
# Only client-safe values belong here. Never put a secret/service-role key, the database
# password or an AI provider key in any EXPO_PUBLIC_ variable: they ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: the public email-link landing page (web/auth-link, see docs/supabase-setup.md).
# Leave unset to send links straight to the app. Must also be allow-listed in Supabase with /**.
# EXPO_PUBLIC_AUTH_LINK_URL=https://your-name.github.io/kindway-links/
